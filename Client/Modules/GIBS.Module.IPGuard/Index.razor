@using System.Linq
@using System.Net
@using GIBS.Module.IPGuard.Models
@using GIBS.Module.IPGuard.Services
@using Oqtane.Modules.Controls

@namespace GIBS.Module.IPGuard
@inherits ModuleBase
@inject IIPGuardService ClientIPGuardService

@if (_blockedIps == null || _errorAttempts == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <TabStrip ActiveTab="BlockedIps">
        <TabPanel Name="BlockedIps" Heading="Blocked IP Addresses">
            <div class="d-flex justify-content-end align-items-center mb-3 mt-3 gap-2">
                <button type="button" class="btn btn-outline-primary" @onclick="RefreshBlockedIps">Refresh</button>
                <ActionLink Action="Add" Security="SecurityAccessLevel.Edit" Text="Block IP" />
            </div>

            @if (_blockedIps.Count > 0)
            {
                <Pager Items="@_blockedIps" PageSize="10" Toolbar="Bottom" Class="table table-striped table-bordered align-middle" SearchProperties="IpAddress,CountryLookup">
                    <Header>
                        <th>IP Address</th>
                        <th>Country Lookup</th>
                        <th>Error Count</th>
                        <th>Blocked Date</th>
                        <th>Reason</th>
                        <th style="width: 1px;">Actions</th>
                    </Header>
                    <Row Context="blockedIp">
                        <td><a href="https://www.ipqualityscore.com/ip-fraud-score-risk-checker/lookup/@blockedIp.IpAddress" target="_blank">@blockedIp.IpAddress</a></td>
                        <td>@blockedIp.CountryLookup</td>
                        <td>@blockedIp.ErrorCount</td>
                        <td style="white-space: nowrap;">@blockedIp.BlockedDate.ToLocalTime().ToString("g")</td>
                        <td>@blockedIp.Reason</td>
                        <td>
                            <div class="btn-group btn-group-sm">
                                <ActionLink Action="Edit" Parameters="@($"id=" + blockedIp.BlockedIpId.ToString())" ResourceKey="Edit" />
                                <ActionLink Action="Delete" Parameters="@($"id=" + blockedIp.BlockedIpId.ToString())" Text="Unblock" Class="btn btn-danger" />
                            </div>
                        </td>
                    </Row>
                </Pager>
            }
            else
            {
                <div class="alert alert-success">No IP addresses are currently blocked.</div>
            }
        </TabPanel>

        <TabPanel Name="Recent404" Heading="Recent 404 Attempts">
            @if (_errorAttempts.Count > 0)
            {
                <div class="d-flex justify-content-end align-items-end gap-2 mb-3 mt-3">
                    <button type="button" class="btn btn-outline-primary" @onclick="RefreshErrorAttempts">Refresh</button>
                    <button type="button" class="btn btn-outline-danger" @onclick="OpenDeleteByIpModal">Delete By IP</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteAllErrorAttempts">Delete All</button>
                </div>

                <Pager Items="@_errorAttempts" PageSize="50" Toolbar="Bottom" Class="table table-striped table-bordered align-middle" SearchProperties="IpAddress,RequestedUrl">
                    <Header>
                        <th>IP Address</th>
                        <th>Requested URL</th>
                        <th>Attempt Date</th>
                        <th style="width: 1px;">Block</th>
                    </Header>
                    <Row Context="attempt">
                        <td><a href="https://www.ipqualityscore.com/free-ip-lookup-proxy-vpn-test/lookup/@attempt.IpAddress" target="_blank">@attempt.IpAddress</a></td>
                        <td style="max-width: 760px;">@attempt.RequestedUrl</td>
                        <td style="white-space: nowrap;">@attempt.AttemptDate.ToLocalTime().ToString("g")</td>
                        <td>
                            <button type="button" class="btn btn-sm btn-outline-danger text-nowrap" @onclick="() => AddToBlocked(attempt.IpAddress)"><i class="oi oi-circle-x"></i></button>
                        </td>
                    </Row>
                </Pager>
            }
            else
            {
                <div class="alert alert-info">No 404 attempts have been recorded yet.</div>
            }
        </TabPanel>
    </TabStrip>
}

@if (_showDeleteByIpModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,.5);" role="dialog" aria-modal="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Delete 404 Attempts by IP</h5>
                    <button type="button" class="btn-close" aria-label="Close" @onclick="CloseDeleteByIpModal"></button>
                </div>
                <div class="modal-body">
                    <label class="form-label" for="deleteIpAddress">IP Address</label>
                    <input id="deleteIpAddress" class="form-control" value="@_deleteIpAddress" @oninput="OnDeleteIpAddressInput" maxlength="45" placeholder="Enter IPv4 or IPv6 address" />
                    <small class="form-text text-muted">Valid formats: IPv4 (e.g. 192.168.1.10) or IPv6 (e.g. 2001:db8::1)</small>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDeleteByIpModal">Cancel</button>
                    <button type="button" class="btn btn-danger" @onclick="DeleteErrorAttemptsByIpAddress">Delete</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    public override string RenderMode => RenderModes.Interactive;

    public override List<Resource> Resources => new List<Resource>()
    {
        new Stylesheet("_content/GIBS.Module.IPGuard/Module.css"),
        new Script("_content/GIBS.Module.IPGuard/Module.js")
    };

    private List<BlockedIp> _blockedIps;
    private List<ErrorAttempt> _errorAttempts;
    private bool _showDeleteByIpModal;
    private string _deleteIpAddress;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            await LoadData();
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error Loading IPGuard {Error}", ex.Message);
            AddModuleMessage($"Error loading IPGuard dashboard: {ex.Message}", MessageType.Error);
        }
    }

    private async Task LoadData()
    {
        _blockedIps = await ClientIPGuardService.GetBlockedIpsAsync(ModuleState.ModuleId) ?? new List<BlockedIp>();
        _errorAttempts = await ClientIPGuardService.GetErrorAttemptsAsync(ModuleState.ModuleId) ?? new List<ErrorAttempt>();
    }

    private async Task RefreshBlockedIps()
    {
        await LoadData();
    }

    private async Task RefreshErrorAttempts()
    {
        await LoadData();
    }

    private void OpenDeleteByIpModal()
    {
        _deleteIpAddress = string.Empty;
        _showDeleteByIpModal = true;
    }

    private void CloseDeleteByIpModal()
    {
        _showDeleteByIpModal = false;
        _deleteIpAddress = string.Empty;
    }

    private void OnDeleteIpAddressInput(ChangeEventArgs args)
    {
        var value = args?.Value?.ToString() ?? string.Empty;
        var filteredValue = new string(value.Where(ch =>
            char.IsDigit(ch) ||
            (ch >= 'a' && ch <= 'f') ||
            (ch >= 'A' && ch <= 'F') ||
            ch == '.' ||
            ch == ':').ToArray());

        _deleteIpAddress = filteredValue.Length > 45 ? filteredValue[..45] : filteredValue;
    }

    private async Task DeleteErrorAttemptsByIpAddress()
    {
        try
        {
            var ipAddress = _deleteIpAddress?.Trim();
            if (string.IsNullOrWhiteSpace(ipAddress))
            {
                AddModuleMessage("Please enter an IP address.", MessageType.Warning);
                return;
            }

            if (!IPAddress.TryParse(ipAddress, out _))
            {
                AddModuleMessage("Please enter a valid IPv4 or IPv6 address.", MessageType.Warning);
                return;
            }

            await ClientIPGuardService.DeleteErrorAttemptsByIpAddressAsync(ipAddress, ModuleState.ModuleId);
            await LoadData();
            CloseDeleteByIpModal();
            AddModuleMessage($"Deleted 404 attempts for {ipAddress}.", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error deleting error attempts for IP address {IpAddress} {Error}", _deleteIpAddress, ex.Message);
            AddModuleMessage($"Error deleting 404 attempts by IP: {ex.Message}", MessageType.Error);
        }
    }

    private async Task DeleteAllErrorAttempts()
    {
        try
        {
            var confirmed = await JSRuntime.InvokeAsync<bool>("confirm", "Delete all recent 404 attempts?");
            if (!confirmed)
            {
                return;
            }

            await ClientIPGuardService.DeleteAllErrorAttemptsAsync(ModuleState.ModuleId);
            _errorAttempts = new List<ErrorAttempt>();
            AddModuleMessage("All recent 404 attempts were deleted.", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error deleting error attempts {Error}", ex.Message);
            AddModuleMessage($"Error deleting 404 attempts: {ex.Message}", MessageType.Error);
        }
    }

    private async Task AddToBlocked(string ipAddress)
    {
        try
        {
            if (string.IsNullOrWhiteSpace(ipAddress))
            {
                AddModuleMessage("Unable to block an empty IP address.", MessageType.Warning);
                return;
            }

            await ClientIPGuardService.AddToBlockedAsync(ipAddress, ModuleState.ModuleId);
            await LoadData();
            AddModuleMessage($"Added {ipAddress} to blocked IP addresses and removed its 404 attempts.", MessageType.Success);
        }
        catch (Exception ex)
        {
            await logger.LogError(ex, "Error adding IP address to blocked list {IpAddress} {Error}", ipAddress, ex.Message);
            AddModuleMessage($"Error adding IP address to blocked list: {ex.Message}", MessageType.Error);
        }
    }

}
